# Copy to .env and fill in for production
SECRET_KEY=replace-with-a-long-random-string
BASE_URL=https://your-domain.com
PORT=5000
DATABASE_PATH=cutnow.db

# SMS: "console" (dev, prints to logs) or "twilio" (real texts)
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Reminder engine
REMINDER_ENABLED=true
REMINDER_INTERVAL_SECONDS=20
REMINDER_NEAR_POSITION=3

# Cookies
SESSION_COOKIE_SECURE=false