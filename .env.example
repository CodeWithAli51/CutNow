# Copy to .env and fill in for production
SECRET_KEY=replace-with-a-long-random-string
BASE_URL=https://your-domain.com
PORT=5000
DATABASE_PATH=cutnow.db

# ── SMS provider ──────────────────────────────────────────────
# "console"   = dev, prints to log (no real texts)
# "fast2sms"  = real SMS delivery (India, cheapest)
# "twilio"    = global SMS + WhatsApp (needs twilio pip install)
SMS_PROVIDER=console

# ── Fast2SMS (set SMS_PROVIDER=fast2sms) ─────────────────────
# Get your API key from https://www.fast2sms.com (free tier available)
FAST2SMS_API_KEY=
# "q" = quick/promotional (fast, no DLT needed)
# "d" = transactional (needs DLT template approval)
FAST2SMS_ROUTE=q
# Optional: your approved sender ID (e.g. CUTNOW)
FAST2SMS_SENDER_ID=
# Optional: DLT template ID (required only for route "d")
FAST2SMS_TEMPLATE_ID=

# ── Twilio (set SMS_PROVIDER=twilio) ─────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Reminder engine ──────────────────────────────────────────
REMINDER_ENABLED=true
REMINDER_INTERVAL_SECONDS=20
REMINDER_NEAR_POSITION=3

# ── Cookies ──────────────────────────────────────────────────
SESSION_COOKIE_SECURE=false