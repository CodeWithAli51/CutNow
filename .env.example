# Copy to .env and fill in for production
SECRET_KEY=replace-with-a-long-random-string
BASE_URL=https://your-domain.com
PORT=5000
DATABASE_PATH=cutnow.db

# ── SMS provider ──────────────────────────────────────────────
# "console"  = dev, prints to log only (no real texts)
# "android"  = real SMS via Android phone on your WiFi (FREE, open source)
# "twilio"   = cloud SMS + WhatsApp (needs account + credit)
SMS_PROVIDER=console

# ── Android phone SMS gateway (set SMS_PROVIDER=android) ──────
# Completely free — uses your phone's own SIM card.
#
# Setup (5 minutes):
#   1. Install "SMS Gateway" app on an Android phone with a SIM card
#      - F-Droid: https://f-droid.org/packages/com.edouard.frenchy.sms/
#      - Or search "SMS Gateway" on Google Play
#   2. Open the app → tap Start → note the IP:port shown
#   3. Phone must be on the SAME WiFi network as your server
#   4. Set the URL below:
ANDROID_GATEWAY_URL=
# Example: ANDROID_GATEWAY_URL=http://192.168.1.50:8080/v1/sms

# ── Twilio (set SMS_PROVIDER=twilio) ─────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Reminder engine ──────────────────────────────────────────
REMINDER_ENABLED=true
REMINDER_INTERVAL_SECONDS=20
REMINDER_NEAR_POSITION=3

# ── Cookies ──────────────────────────────────────────────────
SESSION_COOKIE_SECURE=false